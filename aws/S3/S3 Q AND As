pythondef parallel_multipart_upload(file_path, bucket, key, part_size=50*1024*1024):
    """
    Custom multipart upload with parallel workers
    """
    file_size = os.path.getsize(file_path)
    num_parts = math.ceil(file_size / part_size)
    
    # Initiate multipart upload
    response = s3.create_multipart_upload(
        Bucket=bucket,
        Key=key,
        ServerSideEncryption='AES256'
    )
    upload_id = response['UploadId']
    
    def upload_part(part_number, start, end):
        """Upload single part"""
        with open(file_path, 'rb') as f:
            f.seek(start)
            data = f.read(end - start)
        
        response = s3.upload_part(
            Bucket=bucket,
            Key=key,
            PartNumber=part_number,
            UploadId=upload_id,
            Body=data
        )
        
        return {
            'PartNumber': part_number,
            'ETag': response['ETag']
        }
    
    # Upload parts in parallel
    parts = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
        futures = []
        
        for part_num in range(1, num_parts + 1):
            start = (part_num - 1) * part_size
            end = min(start + part_size, file_size)
            
            future = executor.submit(upload_part, part_num, start, end)
            futures.append(future)
        
        for future in concurrent.futures.as_completed(futures):
            parts.append(future.result())
    
    # Sort parts by PartNumber
    parts.sort(key=lambda x: x['PartNumber'])
    
    # Complete multipart upload
    s3.complete_multipart_upload(
        Bucket=bucket,
        Key=key,
        UploadId=upload_id,
        MultipartUpload={'Parts': parts}
    )
    
    print(f"Uploaded {file_path} in {num_parts} parts")

# Upload 10GB file
parallel_multipart_upload('10GB_file.bin', 'my-bucket', 'large/10GB_file.bin')
