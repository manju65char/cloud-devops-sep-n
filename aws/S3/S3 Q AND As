pythonimport concurrent.futures
import time

def upload_file_optimized(file_info):
    """Upload single file with distributed prefix"""
    file_path, bucket = file_info
    filename = os.path.basename(file_path)
    
    # Get distributed key
    s3_key = get_distributed_prefix(filename)
    
    try:
        # Upload with metadata
        s3.upload_file(
            file_path,
            bucket,
            s3_key,
            ExtraArgs={
                'ContentType': 'application/octet-stream',
                'ServerSideEncryption': 'AES256',
                'Metadata': {
                    'upload_time': str(int(time.time())),
                    'original_name': filename
                }
            }
        )
        return f"Success: {s3_key}"
    except Exception as e:
        return f"Error: {filename} - {str(e)}"

def batch_upload(file_list, bucket, max_workers=100):
    """
    Upload files in parallel with thread pool
    50,000 files with 100 workers = ~10 minutes
    """
    file_info_list = [(f, bucket) for f in file_list]
    
    results = {'success': 0, 'error': 0}
    start_time = time.time()
    
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        future_to_file = {
            executor.submit(upload_file_optimized, info): info[0] 
            for info in file_info_list
        }
        
        for future in concurrent.futures.as_completed(future_to_file):
            result = future.result()
            if result.startswith('Success'):
                results['success'] += 1
            else:
                results['error'] += 1
                print(result)
            
            # Progress indicator
            if (results['success'] + results['error']) % 1000 == 0:
                elapsed = time.time() - start_time
                rate = (results['success'] + results['error']) / elapsed
                print(f"Processed: {results['success'] + results['error']}, Rate: {rate:.0f}/sec")
    
    total_time = time.time() - start_time
    print(f"\nTotal: {results['success']} succeeded, {results['error']} failed in {total_time:.2f}s")
    print(f"Average rate: {len(file_list)/total_time:.0f} files/second")

