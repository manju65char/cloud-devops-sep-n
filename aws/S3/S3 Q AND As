pythonimport boto3
from datetime import datetime, timedelta

cloudwatch = boto3.client('cloudwatch')

def monitor_s3_performance(bucket_name):
    """Monitor S3 request metrics"""
    
    end_time = datetime.utcnow()
    start_time = end_time - timedelta(hours=1)
    
    # Get request metrics
    response = cloudwatch.get_metric_statistics(
        Namespace='AWS/S3',
        MetricName='AllRequests',
        Dimensions=[
            {'Name': 'BucketName', 'Value': bucket_name},
            {'Name': 'FilterId', 'Value': 'EntireBucket'}
        ],
        StartTime=start_time,
        EndTime=end_time,
        Period=300,  # 5 minutes
        Statistics=['Sum']
    )
    
    for datapoint in sorted(response['Datapoints'], key=lambda x: x['Timestamp']):
        requests_per_5min = datapoint['Sum']
        requests_per_second = requests_per_5min / 300
        print(f"{datapoint['Timestamp']}: {requests_per_second:.2f} req/s")
    
    # Get 4xx/5xx errors
    for error_code in ['4xxErrors', '5xxErrors']:
        response = cloudwatch.get_metric_statistics(
            Namespace='AWS/S3',
            MetricName=error_code,
            Dimensions=[
                {'Name': 'BucketName', 'Value': bucket_name}
            ],
            StartTime=start_time,
            EndTime=end_time,
            Period=3600,
            Statistics=['Sum']
        )
        
        if response['Datapoints']:
            total_errors = response['Datapoints'][0]['Sum']
            print(f"{error_code}: {total_errors}")

monitor_s3_performance('my-high-throughput-bucket')
