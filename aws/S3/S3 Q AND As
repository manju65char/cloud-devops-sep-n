Step 2: Restore from Glacier (Batch Restore)
pythonimport boto3
import json
from datetime import datetime

s3control = boto3.client('s3control')
account_id = '123456789012'

def create_batch_restore_job(manifest_location, bucket):
    """
    Batch restore objects from Glacier
    """
    
    job_config = {
        'Manifest': {
            'Spec': {
                'Format': 'S3InventoryReport_CSV_20211130',
                'Fields': ['Bucket', 'Key']
            },
            'Location': {
                'ObjectArn': manifest_location,
                'ETag': 'manifest-etag'
            }
        },
        'Operation': {
            'S3InitiateRestoreObject': {
                'ExpirationInDays': 7,  # Keep restored copy for 7 days
                'GlacierJobTier': 'STANDARD'  # STANDARD, BULK, or EXPEDITED
            }
        },
        'Report': {
            'Bucket': f'arn:aws:s3:::batch-reports',
            'Format': 'Report_CSV_20180820',
            'Enabled': True,
            'Prefix': 'restore-job/',
            'ReportScope': 'AllTasks'  # or 'FailedTasksOnly'
        },
        'Priority': 10,
        'RoleArn': 'arn:aws:iam::123456789012:role/S3BatchOperationsRole',
        'ConfirmationRequired': False,  # Set to True for review before execution
        'Description': f'Batch restore from Glacier - {datetime.now().isoformat()}'
    }
    
    response = s3control.create_job(
        AccountId=account_id,
        **job_config
    )
    
    job_id = response['JobId']
    print(f"Created batch restore job: {job_id}")
    return job_id

# Create job
manifest_arn = 'arn:aws:s3:::inventory-bucket/inventory/source-bucket/glacier-objects/2025-01-01T00-00Z/manifest.json'
job_id = create_batch_restore_job(manifest_arn, 'source-bucket')
Step 3: Change Storage Class (After Restore)
pythondef create_batch_storage_class_job(manifest_location, target_storage_class='INTELLIGENT_TIERING'):
    """
    Change storage class for millions of objects
    """
    
    job_config = {
        'Manifest': {
            'Spec': {
                'Format': 'S3InventoryReport_CSV_20211130',
                'Fields': ['Bucket', 'Key']
            },
            'Location': {
                'ObjectArn': manifest_location,
                'ETag': 'manifest-etag'
            }
        },
        'Operation': {
            'S3PutObjectCopy': {
                'TargetResource': 'arn:aws:s3:::source-bucket',
                'StorageClass': target_storage_class,
                'MetadataDirective': 'COPY',  # Keep existing metadata
                'CannedAccessControlList': 'private',
                'RequesterPays': False
            }
        },
        'Report': {
            'Bucket': f'arn:aws:s3:::batch-reports',
            'Format': 'Report_CSV_20180820',
            'Enabled': True,
            'Prefix': 'storage-class-job/',
            'ReportScope': 'AllTasks'
        },
        'Priority': 10,
        'RoleArn': 'arn:aws:iam::123456789012:role/S3BatchOperationsRole',
        'ConfirmationRequired': False,
        'Description': f'Change to {target_storage_class}'
    }
    
    response = s3control.create_job(
        AccountId=account_id,
        **job_config
    )
    
    return response['JobId']

# Execute
