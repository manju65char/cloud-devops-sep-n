pythondef monitor_batch_job(job_id):
    """Monitor batch job progress"""
    
    while True:
        response = s3control.describe_job(
            AccountId=account_id,
            JobId=job_id
        )
        
        job = response['Job']
        status = job['Status']
        
        print(f"\nJob ID: {job_id}")
        print(f"Status: {status}")
        
        if 'ProgressSummary' in job:
            progress = job['ProgressSummary']
            print(f"Total Objects: {progress.get('TotalNumberOfTasks', 0)}")
            print(f"Succeeded: {progress.get('NumberOfTasksSucceeded', 0)}")
            print(f"Failed: {progress.get('NumberOfTasksFailed', 0)}")
            
            if progress.get('TotalNumberOfTasks', 0) > 0:
                percent = (progress.get('NumberOfTasksSucceeded', 0) / 
                          progress.get('TotalNumberOfTasks', 1)) * 100
                print(f"Progress: {percent:.2f}%")
        
