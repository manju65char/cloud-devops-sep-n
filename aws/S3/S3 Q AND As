Step 8: Custom Manifest (Selective Operations)
pythondef create_custom_manifest(bucket, prefix, filter_func):
    """
    Create custom manifest for selective operations
    """
    s3 = boto3.client('s3')
    
    # List objects
    paginator = s3.get_paginator('list_objects_v2')
    pages = paginator.paginate(Bucket=bucket, Prefix=prefix)
    
    manifest_lines = []
    
    for page in pages:
        for obj in page.get('Contents', []):
            # Apply custom filter
            if filter_func(obj):
                # Add to manifest
                manifest_lines.append(f"{bucket},{obj['Key']}\n")
    
    # Upload manifest
    manifest_content = ''.join(manifest_lines)
    manifest_key = f"manifests/custom-manifest-{datetime.now().strftime('%Y%m%d%H%M%S')}.csv"
    
    s3.put_object(
        Bucket='inventory-bucket',
        Key=manifest_key,
        Body=manifest_content.encode('utf-8')
    )
    
    print(f"Created manifest with {len(manifest_lines)} objects")
    return f"arn:aws:s3:::inventory-bucket/{manifest_key}"

