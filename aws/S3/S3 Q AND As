pythonfrom cryptography.fernet import Fernet
import boto3

class S3ClientSideEncryption:
    def __init__(self, bucket):
        self.bucket = bucket
        self.s3 = boto3.client('s3')
        self.key = Fernet.generate_key()  # Store securely!
        self.cipher = Fernet(self.key)
    
    def upload_encrypted(self, file_path, s3_key):
        """Encrypt and upload file"""
        # Read file
        with open(file_path, 'rb') as f:
            data = f.read()
        
        # Encrypt
        encrypted_data = self.cipher.encrypt(data)
        
        # Upload
        self.s3.put_object(
            Bucket=self.bucket,
            Key=s3_key,
            Body=encrypted_data,
            Metadata={'encrypted': 'client-side'}
        )
        print(f"Uploaded encrypted: {s3_key}")
    
    def download_decrypt(self, s3_key, output_path):
        """Download and decrypt file"""
        # Download
        response = self.s3.get_object(Bucket=self.bucket, Key=s3_key)
        encrypted_data = response['Body'].read()
        
        # Decrypt
        decrypted_data = self.cipher.decrypt(encrypted_data)
        
        # Save
        with open(output_path, 'wb') as f:
            f.write(decrypted_data)
        print(f"Downloaded and decrypted: {output_path}")

