### **5. S3 Lifecycle Policies**
**Q:** Design a comprehensive lifecycle policy for application logs with different retention requirements.

**A:**

**Scenario Requirements:**
```
- Access logs: Keep 90 days (frequently accessed first 7 days)
- Error logs: Keep 1 year (frequently accessed first 30 days)
- Audit logs: Keep 7 years (compliance requirement)
- Debug logs: Keep 30 days only
- Old versions: Transition to Glacier after 30 days, delete after 90 days
Complete Lifecycle Policy:
xml<LifecycleConfiguration>
  <!-- Rule 1: Access Logs -->
  <Rule>
    <ID>AccessLogsLifecycle</ID>
    <Filter>
      <Prefix>logs/access/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    
    <!-- Day 0-7: Standard (frequent analysis) -->
    <!-- Day 7-30: Move to IA -->
    <Transition>
      <Days>7</Days>
      <StorageClass>STANDARD_IA</StorageClass>
    </Transition>
    
    <!-- Day 30-90: Move to Glacier Instant -->
    <Transition>
      <Days>30</Days>
      <StorageClass>GLACIER_IR</StorageClass>
    </Transition>
    
    <!-- Day 90: Delete -->
    <Expiration>
      <Days>90</Days>
    </Expiration>
    
    <!-- Clean up incomplete multipart uploads -->
    <AbortIncompleteMultipartUpload>
      <DaysAfterInitiation>7</DaysAfterInitiation>
    </AbortIncompleteMultipartUpload>
  </Rule>
  
  <!-- Rule 2: Error Logs -->
  <Rule>
    <ID>ErrorLogsLifecycle</ID>
    <Filter>
      <And>
        <Prefix>logs/error/</Prefix>
        <Tag>
          <Key>LogType</Key>
          <Value>Error</Value>
        </Tag>
      </And>
    </Filter>
    <Status>Enabled</Status>
    
    <!-- Day 0-30: Standard -->
    <!-- Day 30-90: Move to IA -->
    <Transition>
      <Days>30</Days>
      <StorageClass>STANDARD_IA</StorageClass>
    </Transition>
    
    <!-- Day 90-365: Move to Glacier Flexible -->
    <Transition>
      <Days>90</Days>
      <StorageClass>GLACIER</StorageClass>
    </Transition>
    
    <!-- Day 365: Delete -->
    <Expiration>
      <Days>365</Days>
    </Expiration>
  </Rule>
  
  <!-- Rule 3: Audit Logs (Compliance - 7 years) -->
  <Rule>
    <ID>AuditLogsLifecycle</ID>
    <Filter>
      <Prefix>logs/audit/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    
    <!-- Day 0-30: Standard (recent audits) -->
    <!-- Day 30-90: Move to IA -->
    <Transition>
      <Days>30</Days>
      <StorageClass>STANDARD_IA</StorageClass>
    </Transition>
    
    <!-- Day 90-2555: Move to Deep Archive -->
    <Transition>
      <Days>90</Days>
      <StorageClass>DEEP_ARCHIVE</StorageClass>
    </Transition>
    
    <!-- Day 2555 (7 years): Delete -->
    <Expiration>
      <Days>2555</Days>
    </Expiration>
  </Rule>
  
  <!-- Rule 4: Debug Logs (Short retention) -->
  <Rule>
    <ID>DebugLogsLifecycle</ID>
    <Filter>
      <Prefix>logs/debug/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    
    <!-- Delete after 30 days -->
    <Expiration>
      <Days>30</Days>
    </Expiration>
  </Rule>
  
  <!-- Rule 5: Expired Delete Markers -->
  <Rule>
    <ID>CleanupExpiredDeleteMarkers</ID>
    <Expiration>
      <ExpiredObjectDeleteMarker>true</ExpiredObjectDeleteMarker>
    </Expiration>
    <Status>Enabled</Status>
  </Rule>
  
  <!-- Rule 6: Old Versions Management -->
  <Rule>
    <ID>OldVersionsLifecycle</ID>
    <Filter>
      <Prefix>logs/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    
    <!-- Move noncurrent versions to Glacier after 30 days -->
