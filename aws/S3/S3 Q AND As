Recovery Scenarios:
Scenario 1: Accidental File Deletion
pythonimport boto3

s3 = boto3.client('s3')

def recover_deleted_file(bucket, key):
    """Remove delete marker to restore file"""
    
    # List versions
    response = s3.list_object_versions(Bucket=bucket, Prefix=key)
    
    # Find delete markers
    delete_markers = response.get('DeleteMarkers', [])
    
    if not delete_markers:
        print("No delete markers found. File not deleted.")
        return
    
    # Get the latest delete marker
    latest_delete_marker = delete_markers[0]
    
    if latest_delete_marker['IsLatest']:
        # Remove delete marker to restore file
        s3.delete_object(
            Bucket=bucket,
            Key=key,
            VersionId=latest_delete_marker['VersionId']
        )
        print(f"Restored {key} by removing delete marker {latest_delete_marker['VersionId']}")
    else:
        print("Latest version is not a delete marker. File already exists.")

# Usage
recover_deleted_file('my-bucket', 'important-file.txt')
Scenario 2: File Corruption - Restore Previous Version
pythondef restore_previous_version(bucket, key, versions_back=1):
    """Restore file to a previous version"""
    
    # List versions
    response = s3.list_object_versions(Bucket=bucket, Prefix=key)
    versions = response.get('Versions', [])
    
    if len(versions) < versions_back + 1:
        print(f"Not enough versions. Only {len(versions)} versions exist.")
        return
    
    # Get the version to restore
    target_version = versions[versions_back]
    
    # Copy old version as new latest version
    s3.copy_object(
        Bucket=bucket,
        CopySource={
            'Bucket': bucket,
            'Key': key,
            'VersionId': target_version['VersionId']
        },
        Key=key
    )
    
    print(f"Restored {key} to version from {target_version['LastModified']}")
    print(f"Version ID: {target_version['VersionId']}")

# Usage
restore_previous_version('my-bucket', 'corrupted-file.txt', versions_back=2)
Scenario 3: Bulk Recovery
pythondef bulk_recover_files(bucket, prefix=''):
    """Recover all deleted files in a prefix"""
    
    paginator = s3.get_paginator('list_object_versions')
    pages = paginator.paginate(Bucket=bucket, Prefix=prefix)
    
    recovered_count = 0
    
    for page in pages:
        # Process delete markers
        for delete_marker in page.get('DeleteMarkers', []):
            if delete_marker['IsLatest']:
                s3.delete_object(
                    Bucket=bucket,
                    Key=delete_marker['Key'],
                    VersionId=delete_marker['VersionId']
                )
                print(f"Recovered: {delete_marker['Key']}")
                recovered_count += 1
    
    print(f"Total files recovered: {recovered_count}")

# Usage
bulk_recover_files('my-bucket', prefix='documents/')
