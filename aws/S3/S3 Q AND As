1. S3 Bucket Creation and Basic Operations
Q: Create an S3 bucket following AWS naming best practices and perform basic file operations (upload, download, delete, list).
A:
Bucket Naming Rules:

Globally unique across ALL AWS accounts
3-63 characters
Lowercase letters, numbers, hyphens only
Must start with letter or number
No consecutive dots, no IP format
Cannot start/end with hyphen

Best Practice Naming:
{company}-{environment}-{region}-{purpose}
Example: acmecorp-prod-us-east-1-assets
Operations via CLI:
bash# Create bucket
aws s3 mb s3://acmecorp-prod-us-east-1-assets --region us-east-1

# Upload single file
aws s3 cp myfile.txt s3://acmecorp-prod-us-east-1-assets/

# Upload with metadata
aws s3 cp myfile.txt s3://acmecorp-prod-us-east-1-assets/ \
  --metadata "department=engineering,project=webapp"

# Upload directory recursively
aws s3 cp ./local-folder s3://acmecorp-prod-us-east-1-assets/remote-folder/ --recursive

# Download file
aws s3 cp s3://acmecorp-prod-us-east-1-assets/myfile.txt ./

# List objects
aws s3 ls s3://acmecorp-prod-us-east-1-assets/

# List with details
aws s3 ls s3://acmecorp-prod-us-east-1-assets/ --recursive --human-readable --summarize

# Delete file
aws s3 rm s3://acmecorp-prod-us-east-1-assets/myfile.txt

# Delete all objects in prefix
aws s3 rm s3://acmecorp-prod-us-east-1-assets/old-data/ --recursive

# Sync local to S3 (like rsync)
aws s3 sync ./local-folder s3://acmecorp-prod-us-east-1-assets/backup/ --delete
Using Python Boto3:
pythonimport boto3
from botocore.exceptions import ClientError

s3 = boto3.client('s3')

# Create bucket
def create_bucket(bucket_name, region='us-east-1'):
    try:
        if region == 'us-east-1':
            s3.create_bucket(Bucket=bucket_name)
        else:
            s3.create_bucket(
                Bucket=bucket_name,
                CreateBucketConfiguration={'LocationConstraint': region}
            )
        print(f"Bucket {bucket_name} created successfully")
    except ClientError as e:
        print(f"Error: {e}")

# Upload file
def upload_file(file_path, bucket, object_name=None):
    if object_name is None:
        object_name = file_path
    
    try:
        s3.upload_file(file_path, bucket, object_name)
        print(f"Uploaded {file_path} to {bucket}/{object_name}")
    except ClientError as e:
        print(f"Error: {e}")

# Download file
def download_file(bucket, object_name, file_path):
    try:
        s3.download_file(bucket, object_name, file_path)
        print(f"Downloaded {bucket}/{object_name} to {file_path}")
    except ClientError as e:
        print(f"Error: {e}")

# List objects
def list_objects(bucket, prefix=''):
    try:
        response = s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
        if 'Contents' in response:
            for obj in response['Contents']:
                print(f"{obj['Key']} - {obj['Size']} bytes - {obj['LastModified']}")
    except ClientError as e:
        print(f"Error: {e}")

# Delete object
def delete_object(bucket, key):
    try:
        s3.delete_object(Bucket=bucket, Key=key)
        print(f"Deleted {bucket}/{key}")
    except ClientError as e:
        print(f"Error: {e}")

