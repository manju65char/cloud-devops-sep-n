pythondef create_batch_tagging_job(manifest_location, tags):
    """
    Add tags to millions of objects
    """
    
    tag_set = [{'Key': k, 'Value': v} for k, v in tags.items()]
    
    job_config = {
        'Manifest': {
            'Spec': {
                'Format': 'S3InventoryReport_CSV_20211130',
                'Fields': ['Bucket', 'Key']
            },
            'Location': {
                'ObjectArn': manifest_location,
                'ETag': 'manifest-etag'
            }
        },
        'Operation': {
            'S3PutObjectTagging': {
                'TagSet': tag_set
            }
        },
        'Report': {
            'Bucket': f'arn:aws:s3:::batch-reports',
            'Format': 'Report_CSV_20180820',
            'Enabled': True,
            'Prefix': 'tagging-job/',
            'ReportScope': 'AllTasks'
        },
        'Priority': 10,
        'RoleArn': 'arn:aws:iam::123456789012:role/S3BatchOperationsRole',
        'ConfirmationRequired': False,
        'Description': 'Batch tagging operation'
    }
    
    response = s3control.create_job(
        AccountId=account_id,
        **job_config
    )
    
    return response['JobId']

