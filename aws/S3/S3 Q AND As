pythonimport boto3
import os
from PIL import Image
import io
from urllib.parse import unquote_plus

s3 = boto3.client('s3')

def lambda_handler(event, context):
    """
    Process uploaded images: resize and create thumbnail
    """
    for record in event['Records']:
        # Get bucket and key
        bucket = record['s3']['bucket']['name']
        key = unquote_plus(record['s3']['object']['key'])
        
        print(f"Processing: s3://{bucket}/{key}")
        
        try:
            # Download image
            response = s3.get_object(Bucket=bucket, Key=key)
            image_data = response['Body'].read()
            
            # Open with PIL
            image = Image.open(io.BytesIO(image_data))
            original_format = image.format
            
            # Create thumbnail (200x200)
            thumbnail = image.copy()
            thumbnail.thumbnail((200, 200), Image.LANCZOS)
            
            # Save thumbnail
            thumb_buffer = io.BytesIO()
            thumbnail.save(thumb_buffer, format=original_format, quality=85)
            thumb_buffer.seek(0)
            
            # Upload thumbnail
            thumb_key = key.replace('images/', 'thumbnails/')
            s3.put_object(
                Bucket=bucket,
                Key=thumb_key,
                Body=thumb_buffer,
                ContentType=response['ContentType'],
                Metadata={
                    'original-key': key,
                    'processed-by': 'lambda'
                }
            )
            
            print(f"Created thumbnail: {thumb_key}")
            
            # Optionally: Resize original for web
            if image.width > 1920 or image.height > 1080:
                image.thumbnail((1920, 1080), Image.LANCZOS)
                
                web_buffer = io.BytesIO()
                image.save(web_buffer, format=original_format, quality=90, optimize=True)
                web_buffer.seek(0)
                
                # Upload web version
                web_key = key.replace('images/', 'web/')
                s3.put_object(
                    Bucket=bucket,
                    Key=web_key,
                    Body=web_buffer,
                    ContentType=response['ContentType']
                )
                
                print(f"Created web version: {web_key}")
            
            # Tag original as processed
            s3.put_object_tagging(
                Bucket=bucket,
                Key=key,
                Tagging={
                    'TagSet': [
                        {'Key': 'processed', 'Value': 'true'},
                        {'Key': 'processed-date', 'Value': context.log_stream_name}
                    ]
                }
            )
            
        except Exception as e:
            print(f"Error processing {key}: {str(e)}")
            
            # Send error to DLQ or SNS
            sns = boto3.client('sns')
            sns.publish(
                TopicArn='arn:aws:sns:us-east-1:123456789012:admin-alerts',
                Subject='Image Processing Failed',
                Message=f"Failed to process {key}: {str(e)}"
            )
            
            raise
    
    return {'statusCode': 200, 'body': 'Processing complete'}
