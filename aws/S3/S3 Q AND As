pythondef choose_storage_class(access_frequency, retrieval_urgency, min_storage_days, data_critical):
    """
    Helper function to choose appropriate storage class
    """
    if access_frequency == "daily":
        return "Standard"
    
    elif access_frequency == "unknown":
        return "Intelligent-Tiering"
    
    elif access_frequency == "weekly" or access_frequency == "monthly":
        if min_storage_days >= 30:
            if data_critical:
                return "Standard-IA"
            else:
                return "One Zone-IA"
        else:
            return "Standard"
    
    elif access_frequency == "quarterly":
        if min_storage_days >= 90:
            return "Glacier Instant Retrieval"
        else:
            return "Standard-IA"
    
    elif access_frequency == "yearly":
        if retrieval_urgency == "hours_ok":
            return "Glacier Flexible Retrieval"
        else:
            return "Glacier Instant Retrieval"
    
    elif access_frequency == "rarely":
        if retrieval_urgency == "day_ok" and min_storage_days >= 180:
            return "Glacier Deep Archive"
        else:
            return "Glacier Flexible Retrieval"
    
    return "Standard"  # Default safe option

# Example usage
print(choose_storage_class("monthly", "immediate", 45, True))  # Standard-IA
print(choose_storage_class("yearly", "hours_ok", 365, True))   # Glacier Flexible
